{
  "name": "Final Enterprise Outreach Engine (Email + AI Voice Call + Calendar)",
  "nodes": [
    {
      "id": "n8n-node-001",
      "name": "Webhook - Receive Lead & Email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        40
      ],
      "webhookId": "outreach-agent",
      "parameters": {
        "httpMethod": "POST",
        "path": "outreach-agent",
        "responseMode": "onReceived",
        "responseData": "{\"success\": true, \"status\": \"accepted\", \"message\": \"Lead received. Running in the background.\"}",
        "options": {}
      }
    },
    {
      "id": "n8n-node-002",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -960,
        40
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{$json.body.recipient_email}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "v2",
              "leftValue": "={{$json.body.subject}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "v3",
              "leftValue": "={{$json.body.email_body}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n8n-node-003",
      "name": "Log Invalid Payload",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -720,
        220
      ],
      "parameters": {}
    },
    {
      "id": "n8n-node-004",
      "name": "Send Initial Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -720,
        -80
      ],
      "parameters": {
        "sendTo": "={{$json.body.recipient_email}}",
        "subject": "={{$json.body.subject}}",
        "emailType": "text",
        "message": "={{$json.body.email_body}}",
        "options": {
          "senderName": "={{$json.body.sender_name}}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "n8n-node-005",
      "name": "Wait 3 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -480,
        -80
      ],
      "parameters": {
        "amount": 3,
        "unit": "days"
      },
      "webhookId": "wait-3-days-resume"
    },
    {
      "id": "n8n-node-006",
      "name": "Search For Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -240,
        -80
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 5,
        "filters": {
          "q": "=from:{{$('Webhook - Receive Lead & Email').item.json.body.recipient_email}} newer_than:4d"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "n8n-node-007",
      "name": "Has Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        0,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "r1",
              "leftValue": "={{$json.id}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n8n-node-008",
      "name": "Has Phone Number?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "p1",
              "leftValue": "={{$('Webhook - Receive Lead & Email').item.json.body.recipient_phone}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n8n-node-009",
      "name": "Trigger Vapi AI Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        60
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.vapi.ai/call",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"phoneNumberId\": \"REPLACE_WITH_YOUR_VAPI_PHONE_NUMBER_ID\", \"customer\": { \"number\": $('Webhook - Receive Lead & Email').item.json.body.recipient_phone, \"name\": $('Webhook - Receive Lead & Email').item.json.body.lead_name }, \"assistant\": { \"model\": { \"provider\": \"openai\", \"model\": \"gpt-4o-mini\", \"messages\": [ { \"role\": \"system\", \"content\": \"You are an AI outreach assistant calling on behalf of \" + $('Webhook - Receive Lead & Email').item.json.body.sender_name + \". The lead was emailed 3 days ago about '\" + $('Webhook - Receive Lead & Email').item.json.body.subject + \"' and has not replied. Politely check if they saw the email, answer questions briefly, and offer to book a short call if interested. Keep it concise and natural.\" } ] }, \"voice\": { \"provider\": \"vapi\", \"voiceId\": \"Elliot\" }, \"firstMessage\": \"Hi \" + $('Webhook - Receive Lead & Email').item.json.body.lead_name + \", this is an AI assistant following up on an email about \" + $('Webhook - Receive Lead & Email').item.json.body.subject + \". Do you have a moment?\" } } }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_VAPI_API_KEY_CREDENTIAL_ID",
          "name": "Vapi API Key"
        }
      }
    },
    {
      "id": "n8n-node-010",
      "name": "Log: Vapi Call Triggered",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        60
      ],
      "parameters": {}
    },
    {
      "id": "n8n-node-011",
      "name": "Log: Skipped (No Phone)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        480,
        240
      ],
      "parameters": {
        "notes": "No recipient_phone was provided for this lead, so the Vapi call step was skipped instead of failing or falling back to any hardcoded number."
      }
    },
    {
      "id": "n8n-node-012",
      "name": "AI Sentiment Classifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        -300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"contents\": [ { \"parts\": [ { \"text\": \"You are a sentiment classifier for sales/outreach email replies. Read the reply snippet below and respond with ONLY strict JSON, no markdown, no extra text, in this exact shape: {\\\"interested\\\": true or false, \\\"reason\\\": \\\"one short sentence\\\"}.\\n\\nReply snippet: \" + $('Search For Reply').item.json.snippet } ] } ] } }}",
        "options": {}
      },
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_WITH_YOUR_GEMINI_QUERY_AUTH_CREDENTIAL_ID",
          "name": "Gemini API Key (query: key)"
        }
      }
    },
    {
      "id": "n8n-node-013",
      "name": "Parse Sentiment JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -300
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { interested: true, reason: 'Could not parse AI response — flagged for manual review.' };\n}\nreturn [{ json: parsed }];"
      }
    },
    {
      "id": "n8n-node-014",
      "name": "Is Interested?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        -300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "i1",
              "leftValue": "={{$json.interested}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n8n-node-015",
      "name": "Auto Reply + Meeting Link",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        -420
      ],
      "parameters": {
        "sendTo": "={{$('Webhook - Receive Lead & Email').item.json.body.recipient_email}}",
        "subject": "=Re: {{$('Webhook - Receive Lead & Email').item.json.body.subject}}",
        "emailType": "text",
        "message": "=Hi {{$('Webhook - Receive Lead & Email').item.json.body.lead_name}},\n\nThanks for your interest! Here's my scheduling link so we can find a time that works: {{$('Webhook - Receive Lead & Email').item.json.body.meeting_link}}\n\nBest,\n{{$('Webhook - Receive Lead & Email').item.json.body.sender_name}}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "n8n-node-016",
      "name": "Mark as Not Interested",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        -180
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "status",
              "type": "string",
              "value": "not_interested"
            },
            {
              "id": "s2",
              "name": "lead_email",
              "type": "string",
              "value": "={{$('Webhook - Receive Lead & Email').item.json.body.recipient_email}}"
            },
            {
              "id": "s3",
              "name": "reason",
              "type": "string",
              "value": "={{$('Parse Sentiment JSON').item.json.reason}}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
