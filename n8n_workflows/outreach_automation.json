{
  "name": "AI Outreach Agent - Email Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "outreach-send",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a1a1a1a-0001-4a4a-8a8a-000000000001",
      "name": "Webhook - Receive Lead & Email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 0],
      "webhookId": "outreach-send"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{$json.body.recipient_email}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "cond-2",
              "leftValue": "={{$json.body.subject}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1a1a1a-0002-4a4a-8a8a-000000000002",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "sendTo": "={{$json.body.recipient_email}}",
        "subject": "={{$json.body.subject}}",
        "emailType": "text",
        "message": "={{$json.body.email_body}}",
        "options": {
          "senderName": "={{$json.body.sender_name}}"
        }
      },
      "id": "1a1a1a1a-0003-4a4a-8a8a-000000000003",
      "name": "Send Email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [80, -100],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log-1",
              "name": "status",
              "type": "string",
              "value": "sent"
            },
            {
              "id": "log-2",
              "name": "lead_name",
              "type": "string",
              "value": "={{$('Webhook - Receive Lead & Email').item.json.body.lead_name}}"
            },
            {
              "id": "log-3",
              "name": "recipient_email",
              "type": "string",
              "value": "={{$('Webhook - Receive Lead & Email').item.json.body.recipient_email}}"
            },
            {
              "id": "log-4",
              "name": "sent_at",
              "type": "string",
              "value": "={{$now.toISO()}}"
            }
          ]
        },
        "options": {}
      },
      "id": "1a1a1a1a-0004-4a4a-8a8a-000000000004",
      "name": "Build Success Log",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [320, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"status\": \"sent\", \"lead_name\": $json.lead_name, \"recipient_email\": $json.recipient_email, \"sent_at\": $json.sent_at } }}",
        "options": {}
      },
      "id": "1a1a1a1a-0005-4a4a-8a8a-000000000005",
      "name": "Respond - Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [560, -100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "err-1",
              "name": "status",
              "type": "string",
              "value": "rejected"
            },
            {
              "id": "err-2",
              "name": "reason",
              "type": "string",
              "value": "Missing recipient_email or subject in payload"
            }
          ]
        },
        "options": {}
      },
      "id": "1a1a1a1a-0006-4a4a-8a8a-000000000006",
      "name": "Build Error Log",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [80, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"status\": $json.status, \"reason\": $json.reason } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "1a1a1a1a-0007-4a4a-8a8a-000000000007",
      "name": "Respond - Rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [320, 120]
    }
  ],
  "connections": {
    "Webhook - Receive Lead & Email": {
      "main": [
        [
          {
            "node": "Validate Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Payload": {
      "main": [
        [
          {
            "node": "Send Email (Gmail)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Error Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email (Gmail)": {
      "main": [
        [
          {
            "node": "Build Success Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Success Log": {
      "main": [
        [
          {
            "node": "Respond - Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Error Log": {
      "main": [
        [
          {
            "node": "Respond - Rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
